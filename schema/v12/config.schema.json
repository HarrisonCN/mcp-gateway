            "array"
          ]
        },
        "edgeAutonomy": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "edgeFleet": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "edgeRuntime": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "genaiOtel": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "identity": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "marketplace": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "multimodal": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
