{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HarrisonCN/mcp-gateway/blob/main/schema/v12/config.schema.json",
  "title": "MCP Gateway config schema v12 (14.0)",
  "description": "Draft of the config schema 14.0 will run. 13.x runs schema v11 and refuses version 12. See docs/design/schema-v12.md.",
  "type": "object",
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 12
    },
    "modules": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "features": {
      "type": "object",
      "description": "Feature module sections, each named after its module id (camelCase).",
      "additionalProperties": false,
      "properties": {
        "a2aFederation": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "adaptive": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
