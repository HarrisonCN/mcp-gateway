          ]
        },
        "costAdvisor": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "dataLineage": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "debugSessions": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "dlp": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "ecosystem": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
