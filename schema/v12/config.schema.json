          ]
        },
        "billing": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "blueGreen": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "chaos": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "complianceReports": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "confidential": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "configAssistant": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
