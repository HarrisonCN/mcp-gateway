            "array"
          ]
        },
        "pluginTrust": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "policyEngine": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "policySim": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "pqIdentity": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "pqTls": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "privacy": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "realtimeBudgets": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "regions": {
          "type": "object",
          "description": "Multi-region active-active (5.2). 14.5 adds explicit consistency boundaries: replicated revocations, bounded staleness (fail closed), version vectors, clock-skew bounds. See docs/guides/multi-region.md.",
          "additionalProperties": false,
          "required": [
            "self"
          ],
          "properties": {
            "self": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "description": "this region id"
            },
            "syncIntervalMs": {
              "type": "integer",
              "minimum": 250,
              "default": 5000
            },
            "downAfter": {
              "type": "integer",
              "minimum": 1,
              "default": 3,
              "description": "consecutive failed syncs before a peer is down"
            },
            "peers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "url"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "apiKey": {
                    "type": "string",
                    "description": "operator (unscoped) key on the peer"
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 100
                  }
                }
              }
            },
            "consistency": {
              "type": "object",
              "description": "NEW in 14.5: bounded staleness and clock-skew bounds",
              "additionalProperties": false,
              "properties": {
                "maxStalenessMs": {
                  "type": "integer",
                  "minimum": 500,
                  "description": "a region is fresh while every peer synced within this window (default max(30000, 3 × syncIntervalMs); at least 2 × syncIntervalMs)"
                },
                "maxClockSkewMs": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 30000,
                  "description": "replicated writes stamped further ahead are rejected"
                },
                "onStale": {
                  "enum": [
                    "deny",
                    "allow"
                  ],
                  "default": "deny",
                  "description": "deny = refuse tool calls while not fresh (fail closed, -32027)"
                }
              }
            }
          }
        },
        "rollouts": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "sanitize": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "selfHealing": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "semanticCache": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "sessions": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "sla": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "taskGraphs": {
          "type": "object",
          "description": "Task graphs (10.7). 14.4 adds durable execution: resume after restart, idempotency keys, DLQ, approval resume. See docs/guides/durable-tasks.md.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "dir": {
              "type": "string",
              "minLength": 1,
              "description": "checkpoint directory (relative to the config file)"
            },
            "maxRuns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 500
            },
            "durable": {
              "type": "object",
              "description": "NEW in 14.4: durable execution (absent = 10.7 checkpoints)",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "backend": {
                  "enum": [
                    "auto",
                    "store",
                    "dir",
                    "memory"
                  ],
                  "default": "auto",
                  "description": "auto: the gateway store when it is not memory, else dir, else memory"
                },
                "resumeOnStart": {
                  "type": "boolean",
                  "default": true,
                  "description": "continue runs left in flight (lease lapsed) from their last committed step"
                },
                "leaseMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 600000,
                  "default": 15000,
                  "description": "heartbeat lease of an executing gateway"
                },
                "sweepIntervalMs": {
                  "type": "integer",
                  "minimum": 50,
                  "maximum": 600000,
                  "default": 2000
                },
                "idempotencyTtlSeconds": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 7776000,
                  "default": 86400,
                  "description": "how long a submission idempotency key is remembered"
                },
                "dlq": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": "boolean",
                      "default": true
                    },
                    "retry": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100,
                          "default": 3
                        },
                        "backoffMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 86400000,
                          "default": 30000
                        },
                        "factor": {
                          "type": "number",
                          "minimum": 1,
                          "maximum": 10,
                          "default": 2
                        },
                        "maxBackoffMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 604800000,
                          "default": 3600000
                        },
                        "jitter": {
                          "type": "boolean",
                          "default": false
                        }
                      }
                    }
                  }
                }
              }
            },
            "graphs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "clients": {
                    "type": "boolean",
                    "default": false,
                    "description": "NEW in 14.4 (durable): any authenticated client may start it under /api/v1/features/task-graphs"
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "idempotent": {
                          "type": "boolean",
                          "default": false,
                          "description": "NEW in 14.4: safe to execute again after a crash between call and commit"
                        },
                        "idempotencyArg": {
                          "type": "string",
                          "description": "NEW in 14.4: argument that receives the stable per-call key <runId>:<node> (implies repeat-safe)"
                        },
                        "approval": {
                          "type": "object",
                          "description": "NEW in 14.4 (durable): wait for human approval before the node runs",
                          "additionalProperties": false,
                          "required": [
                            "approvers"
                          ],
                          "properties": {
                            "approvers": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "description": "client id globs"
                            },
                            "required": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 20,
                              "default": 1
                            },
                            "timeoutSeconds": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 2592000,
                              "default": 86400
                            },
                            "reason": {
                              "type": "string",
                              "maxLength": 500
                            }
                          }
                        },
                        "compensate": {
                          "type": "object",
                          "properties": {
                            "tool": {
                              "type": "string"
                            },
                            "args": {
                              "type": "object"
                            },
                            "idempotencyArg": {
                              "type": "string",
                              "description": "NEW in 14.4"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "timeTravel": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        },
        "toolRegistry": {
          "$comment": "unchanged from schema v11 (validated by the runtime schema)",
          "type": [
            "object",
            "array"
          ]
        }
      }
    },
    "a2a": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "audit": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "auth": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "cache": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "catalog": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "chains": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "compliance": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "controlPlane": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema) except the optional `rollout` (14.1)",
      "type": "object",
      "properties": {
        "rollout": {
          "type": "object",
          "description": "NEW in 14.1 (optional; control plane only): how config generations roll out to data planes. See docs/guides/cluster-rollout.md.",
          "additionalProperties": false,
          "properties": {
            "strategy": {
              "enum": [
                "all-at-once",
                "canary"
              ],
              "default": "all-at-once"
            },
            "canary": {
              "type": "object",
              "description": "canary size: a data-plane count or a percentage of the known data planes (strategy canary needs one)",
              "additionalProperties": false,
              "properties": {
                "nodes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "percent": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            "bakeMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400000,
              "default": 30000
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            },
            "autoRollback": {
              "type": "boolean",
              "default": true
            },
            "maxDivergenceMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 86400000,
              "default": 60000
            },
            "history": {
              "type": "integer",
              "minimum": 2,
              "maximum": 100,
              "default": 10
            }
          }
        }
      }
    },
    "cors": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "costs": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "federation": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "health": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "host": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "logLevel": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "mcp": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "monitor": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "mtls": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "observability": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "openai": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "overload": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
    "plugins": {
      "type": "array",
      "description": "Plugins in configuration order. 14.3 adds runtime / failure / permissions and module-plugin limits. See docs/guides/plugin-security.md.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "minLength": 1,
            "description": "ES module path (relative to the config file) or package name"
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "plugin API v5 WASM component"
          },
          "signature": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "options": {
            "type": "object"
          },
          "secrets": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^secret://[A-Za-z0-9_-]+/\\S+$"
            }
          },
          "isolation": {
            "enum": [
              "tenant",
              "client",
              "shared",
              "inline",
              "worker",
              "process"
            ],
            "description": "components: sandbox per tenant | client | shared; module plugins (14.3): alias of runtime"
          },
          "runtime": {
            "enum": [
              "inline",
              "worker",
              "process"
            ],
            "default": "inline",
            "description": "NEW in 14.3 (module plugins): where the plugin runs; worker becomes the default in 15.0"
          },
          "failure": {
            "description": "NEW in 14.3 (module plugins): what a failed hook does",
            "oneOf": [
              {
                "enum": [
                  "open",
                  "closed"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "default": {
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "onToolCall": {
                    "enum": [
                      "open",
                      "closed"
                    ]
                  },
                  "onResponse": {
                    "enum": [
                      "open",
                      "closed"
                    ]
                  }
                }
              }
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000,
            "description": "inline module plugins: per hook call"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60000
              },
              "memoryMb": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "maxInstances": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "description": "components only"
              },
              "maxFailures": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "description": "NEW in 14.3 (module plugins): circuit breaker threshold"
              },
              "cooldownMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000,
                "description": "NEW in 14.3 (module plugins)"
              },
              "maxConcurrent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "description": "NEW in 14.3 (isolated module plugins)"
              }
            }
          },
          "permissions": {
            "type": "object",
            "description": "NEW in 14.3 (module plugins): declared capabilities; network / env / fs need runtime worker or process",
            "additionalProperties": false,
            "properties": {
              "args": {
                "enum": [
                  "read",
                  "write"
                ],
                "default": "write"
              },
              "response": {
                "enum": [
                  "read",
                  "write"
                ],
                "default": "write"
              },
              "secrets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "servers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "hooks": {
                "type": "array",
                "items": {
                  "enum": [
                    "onToolCall",
                    "onResponse",
                    "onError",
                    "onConfigChange"
                  ]
                }
              },
              "network": {
                "oneOf": [
                  {
                    "const": false
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    }
                  }
                ]
              },
              "env": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                }
              },
              "fs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "read": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "write": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "module"
            ]
          },
          {
            "required": [
              "component"
            ]
          }
        ]
      }
    },
    "policy": {
      "$comment": "unchanged from schema v11 (validated by the runtime schema)"
    },
