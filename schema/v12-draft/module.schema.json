{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/HarrisonCN/mcp-gateway/blob/main/schema/v12/module.schema.json",
  "title": "MCP Gateway feature module declaration v12 (14.0)",
  "description": "What a feature module declares to the 14.0 kernel: lifecycle methods, capabilities, config sections, dependencies, failure policy. 13.9 derives it from the manifest (moduleDeclarationV12).",
  "type": "object",
  "required": [
    "id",
    "since",
    "summary",
    "apiVersion",
    "lifecycle",
    "capabilities",
    "configSections",
    "dependsOn"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "since": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "enum": [
        "v12",
        "v12-draft"
      ],
      "description": "'v12' (14.0). 'v12-draft' (13.9) is accepted as a deprecated alias until 15.0.0."
    },
    "configSections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$"
      }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "hook": {
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "mount",
        "init",
        "reconfigure",
        "disable",
        "dispose",
        "health"
      ],
      "additionalProperties": false,
      "properties": {
        "mount": {
          "type": "boolean"
        },
        "init": {
          "type": "boolean"
        },
        "reconfigure": {
          "type": "boolean"
        },
        "disable": {
          "type": "boolean"
        },
        "dispose": {
          "type": "boolean"
        },
        "health": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "admin-routes",
          "client-routes",
          "call-hook",
          "security-guard",
          "background-timers",
          "state-store",
          "outbound-network",
          "filesystem",
          "signing-keys",
          "invoke-tools"
        ]
      }
    },
    "failurePolicy": {
      "type": "object",
      "required": [
        "default",
        "configurable"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "enum": [
            "open",
            "closed",
            "degrade"
          ]
        },
        "configurable": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "hook"
        ]
      },
      "then": {
        "required": [
          "failurePolicy"
        ],
        "properties": {
          "capabilities": {
            "contains": {
              "const": "call-hook"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "contains": {
              "const": "security-guard"
            }
          }
        }
      },
      "then": {
        "required": [
          "failurePolicy"
        ],
        "properties": {
          "failurePolicy": {
            "properties": {
              "default": {
                "const": "closed"
              },
              "configurable": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
