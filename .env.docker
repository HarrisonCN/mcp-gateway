# Environment variables actually read by mcp-gateway.
# Copy to .env (loaded automatically by the CLI) or pass with `docker run --env-file`.
# Everything else is configured in mcp-gateway.yml.

NODE_ENV=production

# Overrides for mcp-gateway.yml
MCP_GATEWAY_PORT=4000
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_LOG_LEVEL=info

# Comma-separated API keys. Setting this switches auth.strategy to "api-key".
MCP_GATEWAY_API_KEYS=replace-with-a-long-random-key

# Secrets referenced from server env blocks as ${VAR}, e.g.
# GITHUB_TOKEN=ghp_...
