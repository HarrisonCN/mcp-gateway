{
  "name": "@winstonsayno/mcp-gateway",
  "version": "13.1.2",
  "description": "MCP gateway for AI models (OpenAI, Grok, DeepSeek, Claude and other function-calling LLMs) and for web pages and apps: one authenticated, observable endpoint in front of your MCP servers with routing, scopes, rate limits and metrics.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "gateway",
    "proxy",
    "llm",
    "ai",
    "developer-tools",
    "observability",
    "typescript",
    "openai",
    "function-calling",
    "deepseek",
    "grok",
    "claude"
  ],
  "homepage": "https://github.com/HarrisonCN/mcp-gateway",
  "bugs": {
    "url": "https://github.com/HarrisonCN/mcp-gateway/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HarrisonCN/mcp-gateway.git"
  },
  "license": "MIT",
  "author": "HarrisonCN",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-gateway": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@noble/post-quantum": "0.7.1",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.4.0",
    "undici": "^6.29.0",
    "ws": "^8.18.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.3.0",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "wit",
    "dashboard/index.html",
    "dashboard/portal.html",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/public.d.ts",
      "import": "./dist/gateway/public.js"
    },
    "./edge": {
      "types": "./dist/edge/entry.d.ts",
      "import": "./dist/edge/entry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
